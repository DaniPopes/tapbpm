{
  "name": "tapbpm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26 <27",
    "npm": ">=11 <12"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "bundle:linux": "tauri build --bundles deb,rpm",
    "bundle:macos": "tauri build --bundles app,dmg",
    "bundle:ios": "npm run build && cap sync ios",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify": "npm run format:check && npm run typecheck && npm test && npm run build && cargo clippy --workspace --all-targets && cargo nextest run --workspace --no-tests pass && npm run bundle:ios && npm run bundle:linux",
    "ios:open": "cap open ios",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.2",
    "prettier": "^3.8.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.13",
    "vitest": "^4.1.6"
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4"
  }
}
