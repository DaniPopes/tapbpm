{
  "name": "tapbpm",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "bundle:linux": "tauri build --bundles deb,rpm",
    "bundle:macos": "tauri build --bundles app,dmg",
    "bundle:ios": "npm run build && cap sync ios",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "ios:open": "cap open ios",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "vite": "^8.0.13"
  },
  "dependencies": {
    "@capacitor/cli": "^8.3.4",
    "@capacitor/core": "^8.3.4",
    "@capacitor/ios": "^8.3.4"
  }
}
