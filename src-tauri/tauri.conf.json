{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tap BPM",
  "version": "0.1.0",
  "identifier": "com.danipopes.tapbpm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tap BPM",
        "width": 480,
        "height": 560,
        "minWidth": 320,
        "minHeight": 320
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Music",
    "shortDescription": "Measure BPM from taps",
    "longDescription": "A single-button app for measuring beats per minute from repeated taps."
  }
}
